DATABASE_URL="file:./dev.db"
JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_api_key
UPLOADS_DIR=uploads/

# Database Configuration for Server System
# Set to true to use server-based database instead of local SQLite
USE_SERVER_DB=false
# Server database connection (when USE_SERVER_DB=true)
# SERVER_DB_URL="postgresql://username:password@localhost:5432/dbname"
# Or for MySQL: "mysql://username:password@localhost:3306/dbname"
# Or for SQL Server: "sqlserver://localhost:1433;database=dbname;username=sa;password=your_password"