  const data = await response.json();
  return data.duplicates;
};

export const apiExtractFields = async (rawData: any): Promise<{ extractedData: { reportData: any; items: any[] }; rawData: any[] }> => {
  const response = await fetch(`${API_BASE_URL}/api/reports/extract-fields`, {
    method: 'POST',
