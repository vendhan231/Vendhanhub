# Copy this file to .env and fill values before running migrations
# For PostgreSQL, special characters in the password (like @, #, :) must be URL-encoded.
# Example: password 'vendhan@123' becomes 'vendhan%40123'

USE_SERVER_DB=true
DATABASE_URL="postgresql://postgres:vendhan%40123@localhost:5432/EMS?schema=public"

# Alternatively you can set a SERVER_DB_URL and leave DATABASE_URL to reference it in code
# SERVER_DB_URL="postgresql://billing_user:your_password@localhost:5432/employee_billing"

JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_api_key
UPLOADS_DIR=uploads/

# Individual DB parts (optional)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=EMS
DB_USERNAME=postgres
# Use the raw password (not URL encoded) here if your app constructs the connection string.
DB_PASSWORD=vendhan@123
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_api_key
UPLOADS_DIR=uploads/