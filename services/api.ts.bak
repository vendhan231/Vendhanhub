// --- Billing API Functions ---
interface BillingFilters {
  userId?: string;
  status?: BillingStatus;
  projectId?: string;
  actingUserRole?: UserRole;
}

export const apiFetchBillingRecords = async (filters?: BillingFilters): Promise<BillingRecord[]> => {
  const queryParams = new URLSearchParams();
  if (filters?.userId) queryParams.append('userId', filters.userId);
  if (filters?.status) queryParams.append('status', filters.status);
  if (filters?.projectId) queryParams.append('projectId', filters.projectId);

  const response = await fetch(`${API_BASE_URL}/api/billing-records?${queryParams.toString()}`, {
    method: 'GET',
    headers: {
      'Content-Type': 'application/json',
      ...(getAuthToken() && { Authorization: `Bearer ${getAuthToken()}` }),
    },
  });

  if (!response.ok) {
    const errorData = await response.json().catch(() => ({}));
    throw new Error(errorData.message || 'Failed to fetch billing records');
  }

  const data = await response.json();
  return data;
};

